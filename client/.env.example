# Stripe Payment Link, PayPal donation URL, or another HTTPS hosted checkout.
# Never place a provider secret key in a VITE_ variable; Vite exposes these
# values in the browser bundle.
VITE_DONATION_URL=https://example.com/replace-with-secure-donation-link

# Public Cloudflare Turnstile site key. Local development automatically uses
# Cloudflare's always-pass test site key when this is omitted.
VITE_TURNSTILE_SITE_KEY=
